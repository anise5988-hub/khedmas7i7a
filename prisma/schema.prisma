generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum TransactionType {
  DEPOSIT
  BOOKING_PAYMENT
  REFUND
  TEACHER_EARNING
  WITHDRAWAL
  WITHDRAWAL_FEE
}

enum DepositMethod {
  D17
  BANK_TRANSFER
  FLOUCI
  ZITOUNA
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  phone     String?
  passwordHash String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   StudentProfile?
  teacher   TeacherProfile?
  wallet    Wallet?
  bookingsAsStudent Booking[] @relation("studentBookings")
  reviews   Review[]
  favorites Favorite[]
  notifications Notification[]
  courseAccesses CourseAccess[]
  courseProgress CourseProgress[]
  couponRedemptions CouponRedemption[]
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]
}

model StudentProfile {
  id          String @id @default(cuid())
  userId      String @unique
  governorate String?
  city        String?
  levelSlug   String?
  section     String?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id                 String @id @default(cuid())
  userId             String @unique
  slug               String @unique
  avatarUrl          String?
  title              String?
  bio                String?
  experienceYears    Int @default(0)
  hourlyRateMillimes Int
  governorate        String?
  city               String?
  online             Boolean @default(true)
  inPerson           Boolean @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects           TeacherSubject[]
  levels             TeacherLevel[]
  availabilities     Availability[]
  bookings           Booking[] @relation("teacherBookings")
  withdrawals        WithdrawalRequest[]
  reviews            Review[]
  favorites          Favorite[]
  courses             Course[]
}

model TeacherSubject {
  teacherId String
  subject   String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@id([teacherId, subject])
}

model TeacherLevel {
  teacherId String
  levelSlug String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@id([teacherId, levelSlug])
}

model Availability {
  id        String @id @default(cuid())
  teacherId String
  dayOfWeek Int
  startTime String
  endTime   String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@index([teacherId, dayOfWeek])
}

model Booking {
  id              String @id @default(cuid())
  studentId       String
  teacherId       String
  startsAt        DateTime
  durationMinutes Int
  amountMillimes  Int
  status          BookingStatus @default(PENDING)
  student         User @relation("studentBookings", fields: [studentId], references: [id])
  teacher         TeacherProfile @relation("teacherBookings", fields: [teacherId], references: [id])
  payment         Payment?
  classroomMessages ClassroomMessage[]
  classroomNotes    ClassroomNote[]
  createdAt       DateTime @default(now())
  @@index([teacherId, startsAt])
  @@index([studentId, startsAt])
}

model ClassroomMessage {
  id             String   @id @default(cuid())
  bookingId      String
  senderId       String
  senderName     String
  text           String?
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}

model ClassroomNote {
  id         String   @id @default(cuid())
  bookingId  String
  authorId   String
  authorName String
  text       String
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}

model Payment {
  id             String @id @default(cuid())
  bookingId      String @unique
  amountMillimes Int
  status         PaymentStatus @default(PENDING)
  providerRef    String?
  idempotencyKey String @unique
  booking        Booking @relation(fields: [bookingId], references: [id])
  createdAt      DateTime @default(now())
}

model Wallet {
  id                String @id @default(cuid())
  userId            String @unique
  availableMillimes Int @default(0)
  pendingMillimes   Int @default(0)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      WalletTransaction[]
  deposits          WalletDeposit[]
}

model WalletDeposit {
  id             String @id @default(cuid())
  walletId       String
  method         DepositMethod
  amountMillimes Int
  reference      String
  proofUrl       String?
  status         PaymentStatus @default(PENDING)
  couponCode     String?
  bonusMillimes  Int @default(0)
  wallet         Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([method, reference])
  @@index([walletId, status, createdAt])
}

enum CouponDiscountType {
  PERCENT
  FIXED_AMOUNT
}

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  discountType      CouponDiscountType
  discountValue     Int
  maxUses           Int?
  usedCount         Int      @default(0)
  minAmountMillimes Int?
  expiresAt         DateTime?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  redemptions       CouponRedemption[]
}

model CouponRedemption {
  id                String   @id @default(cuid())
  couponId          String
  userId            String
  context           String
  amountOffMillimes Int
  createdAt         DateTime @default(now())
  coupon            Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([couponId, userId, context])
  @@index([couponId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  category  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String
  senderName String
  senderRole String
  text       String
  createdAt  DateTime @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model WalletTransaction {
  id             String @id @default(cuid())
  walletId       String
  type           TransactionType
  amountMillimes Int
  reference      String? @unique
  wallet         Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@index([walletId, createdAt])
}

model WithdrawalRequest {
  id                   String @id @default(cuid())
  teacherId            String
  requestedMillimes    Int
  feeMillimes          Int
  payoutMillimes       Int
  method               String
  accountDetails       String
  status               WithdrawalStatus @default(PENDING)
  teacher              TeacherProfile @relation(fields: [teacherId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([status, createdAt])
}

model Review {
  id         String @id @default(cuid())
  studentId  String
  teacherId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  student    User @relation(fields: [studentId], references: [id])
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id])
  @@index([teacherId, createdAt])
}

model Favorite {
  studentId String
  teacherId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@id([studentId, teacherId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  dedupeKey String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, read, createdAt])
}

model Course {
  id              String   @id @default(cuid())
  teacherId       String
  title           String
  description     String
  subject         String
  level           String
  language        String   @default("Français")
  priceTnd        Float    @default(0)
  amountMillimes  Int      @default(0)
  visibility      String   @default("DRAFT")
  thumbnailUrl    String?
  sections        Json
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  studentCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  accesses        CourseAccess[]
  progress        CourseProgress[]
  @@index([teacherId, visibility, createdAt])
  @@index([subject, level, visibility])
}

model CourseAccess {
  id             String   @id @default(cuid())
  courseId       String
  studentId      String
  purchasedAt    DateTime @default(now())
  amountPaidTnd  Float    @default(0)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([courseId, studentId])
  @@index([studentId, purchasedAt])
}

model CourseProgress {
  id                  String   @id @default(cuid())
  courseId            String
  studentId           String
  completedLessonIds  Json
  lastLessonId        String?
  percentage          Int      @default(0)
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student             User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([courseId, studentId])
}

model News {
  id               String   @id @default(cuid())
  title            String
  shortDescription String
  content          String
  imageUrl         String?
  published        Boolean  @default(false)
  authorId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([published, createdAt])
}

model HomepageContent {
  id                 String   @id @default(cuid())
  heroTitlePrefix    String   @default("Trouvez votre prof particulier")
  heroTitleHighlight String   @default("idéal.")
  heroDescription    String   @default("Cours particuliers en ligne par classe virtuelle HD ou en présentiel partout en Tunisie. Des professeurs vérifiés par notre équipe, du primaire au Baccalauréat, pour réussir vos examens et booster vos moyennes.")
  bannerMessage      String?
  bannerLinkUrl      String?
  bannerLinkLabel    String?
  bannerActive       Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, sortOrder])
}

model PlatformSettings {
  id                String   @id @default(cuid())
  commissionRate    Float    @default(10)
  minWithdrawalTnd  Float    @default(10)
  d17Enabled        Boolean  @default(true)
  flouciEnabled     Boolean  @default(true)
  bankTransferEnabled Boolean @default(true)
  supportEmail      String   @default("profyspace@gmail.com")
  supportPhone      String   @default("+216 58 249 938")
  d17Recipient      String?
  flouciRecipient   String?
  bankRib           String?
  updatedAt         DateTime @updatedAt
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  cycle     String
  section   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([cycle, active])
}

model EducationLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  cycle     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([cycle, active, sortOrder])
}

model BacSection {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}
